# Express backend (Supabase → REST migration). Point this at the deployed
# Railway API for prod; the default below matches the backend PORT=5000.
VITE_API_URL=http://localhost:5000/api

# Cloudflare R2 public bucket base (Storage migration off Supabase) --
# used only to derive an object key back out of a stored public URL for
# delete calls. Actual uploads/deletes/signed-reads all go through the
# backend, never hit R2 directly with credentials from the frontend.
VITE_R2_PUBLIC_URL=https://pub-8ce54797ddf14822b5ce5de7b991bbd2.r2.dev


